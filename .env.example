# Copy this file to .env for local development
# On Railway: set these in the Variables tab (never commit .env with real keys!)

# Your OpenAI API key (sk-...)
OPENAI_API_KEY=sk-...

# Max AI generations per device per day (default: 5)
FREE_LIMIT_PER_DAY=5

# Port (Railway sets this automatically)
PORT=3000

# fal.ai key for living drawings (POST /animate); without it /animate answers 503
FAL_KEY=...

# Optional shared secret: when set, /animate requires the same value in the X-App-Secret header
APP_SECRET=...

# Living drawings: model, resolution and daily limits (per device, and for the whole server)
ANIMATE_MODEL=minimax/h3-max-turbo/image-to-video
ANIMATE_RESOLUTION=768P
ANIMATE_PER_DEVICE=5
ANIMATE_PER_DAY=10

# Chat model for the template prompt, photo description and the animation director
OPENAI_MODEL=gpt-6-luna

# Image model for AI coloring pages (gpt-image-1.5 shuts down 2026-12-01) and its quality
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=medium

# «Кисточка угадывает»: guesses per device per day
GUESS_PER_DEVICE=40
